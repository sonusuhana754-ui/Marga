# ==============================================================================
# MARGA Backend API Environment Configuration
# ==============================================================================

# Project & Metadata
PROJECT_NAME="MARGA Backend API"
VERSION="1.0.0"
DESCRIPTION="Backend service foundation for Project MARGA"
API_V1_STR="/api/v1"

# Environment & Debug
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Logging
LOG_LEVEL="INFO"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="marga"
POSTGRES_PORT=5432

# Traffic volatility feed (VA-QPSO adaptive beta). Leave empty to run with
# volatility_signal=false, which the UI reports rather than simulating.
TOMTOM_API_KEY=""

# Graph storage. Defaults are fine under uvicorn. On serverless hosts (Vercel)
# the filesystem outside /tmp is read-only and processes are recycled, so set
# both to /tmp paths: OSMNX_CACHE_DIR=/tmp/marga-cache
# GRAPH_CACHE_DIR=/tmp/marga-graphs
OSMNX_CACHE_DIR="./cache"
GRAPH_CACHE_DIR=""
